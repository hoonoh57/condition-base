# 테스트용 단일 MySQL 계정 (설치/P0/빌드/API 공통)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=srb_test
DB_PASSWORD=
MD_DATABASE=market_data

CORE_DATABASE=srb_core
DERIVED_DATABASE=srb_derived
LAB_DATABASE=srb_lab
DB_POOL_LIMIT=8
DB_TIMEZONE=+09:00

# ─────────────── 서버 ───────────────
PORT=5180
HOST=127.0.0.1
NODE_ENV=development
# 파티션 가드 우회 금지 (운영 중 true 설정 금지)
ALLOW_OOS_BROWSE=false

# ─────────────── 기준 파라미터 기본값 ───────────────
# 전부 최악 가정. 완화는 실측 근거가 있을 때만.
BASELINE_SEVERITY=WORST
COST_MODEL_KEY=NA_DAILY
STOP_DEF_KEY=NA_DAILY
FILL_RULE_KEY=T1_OPEN
TAX_SCHEDULE_VER=TBD_VERIFY_KRX

# ─────────────── 데이터 계약 ───────────────
DATA_ASOF_OVERRIDE=
MINUTE_UNIVERSE_TOP_N=700
