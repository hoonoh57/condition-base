# ─────────────── MySQL 접속 ───────────────
# SSOT(읽기 전용) — market_data
MD_HOST=127.0.0.1
MD_PORT=3306
MD_USER=srb_reader
MD_PASSWORD=
MD_DATABASE=market_data

# 파생 빌드 계정 — srb_derived 쓰기
BUILD_USER=srb_build
BUILD_PASSWORD=

# 실험 계정 — srb_lab 쓰기, core/derived/market_data 읽기
LAB_USER=srb_lab
LAB_PASSWORD=

# 승격 계정 — srb_core INSERT only
PROM_USER=srb_prom
PROM_PASSWORD=

# 스키마 설치 전용 (웹 서버는 사용하지 않음)
ADMIN_USER=
ADMIN_PASSWORD=

CORE_DATABASE=srb_core
DERIVED_DATABASE=srb_derived
LAB_DATABASE=srb_lab
DB_POOL_LIMIT=8
DB_ACCOUNT_HOST=localhost
DB_TIMEZONE=+09:00

# ─────────────── 서버 ───────────────
PORT=5180
HOST=127.0.0.1
NODE_ENV=development
# 파티션 가드 우회 금지 (운영 중 true 설정 금지)
ALLOW_OOS_BROWSE=false

# ─────────────── 기준 파라미터 기본값 ───────────────
# 전부 최악 가정. 완화는 실측 근거가 있을 때만.
BASELINE_SEVERITY=WORST
COST_MODEL_KEY=NA_DAILY
STOP_DEF_KEY=NA_DAILY
FILL_RULE_KEY=T1_OPEN
TAX_SCHEDULE_VER=TBD_VERIFY_KRX

# ─────────────── 데이터 계약 ───────────────
DATA_ASOF_OVERRIDE=
MINUTE_UNIVERSE_TOP_N=700
